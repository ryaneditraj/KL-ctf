# Copy to .env if you need to override a default. .env is gitignored.
# The CLI reads only the two keys below. Other lines are ignored on purpose,
# so this file cannot change PATH or point the tools at a different binary.

# Verify TLS certificates. 1 is the default: valid certificates are checked,
# and a self-signed lab certificate is retried once with verification off.
# Set to 0 only inside an authorized lab whose certificates you already trust.
CYPHERFLAG_TLS_VERIFY=1

# Cloud metadata addresses (169.254.169.254, 169.254.170.2, fd00:ec2::254,
# metadata.google.internal) are refused unless this is 1.
# CYPHERFLAG_ALLOW_METADATA=0
